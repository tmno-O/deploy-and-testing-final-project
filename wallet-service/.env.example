NODE_ENV=development
PORT=3002

# Data is stored in a JSON file (no database yet), so run ONE instance only
# DATA_FILE=./data/mock-data.json
# PERSIST_DATA=true   # true = write changes back to the JSON file, false = keep in memory only

# Must match user-service (>= 32 chars in production). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=user-service

# Shared secret for service-to-service calls (X-Internal-Key), same value in every service.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-to-another-long-random-string-32-chars

# Comma-separated user ids (JWT "sub") allowed to use /admin endpoints
ADMIN_USER_IDS=

# Max requests per minute per IP (health is exempt)
RATE_LIMIT_PER_MINUTE=300

# Number of proxies in front of the service (e.g. API Gateway = 1). Leave empty if none
TRUST_PROXY=

# Allowed origins (comma-separated) or * for development
CORS_ORIGIN=*

# card-catalog-service: the ONLY source of pack prices (GET /packs/:id -> priceCredits).
# Unset = http://localhost:3003 · empty = disabled (pack purchases answer 503)
CATALOG_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_TIMEOUT_MS=3000

# Where top-up money comes from. Only "mock" exists: top-ups are FREE test credits, never expose it publicly.
PAYMENT_PROVIDER=mock
# Limits in whole credits (1 credit = 1 baht)
TOPUP_MIN_AMOUNT=1
TOPUP_MAX_AMOUNT=100000
# A wallet can never hold more than this
MAX_BALANCE=10000000

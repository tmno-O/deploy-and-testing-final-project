NODE_ENV=development
PORT=3005

# Data is stored in a JSON file (mock data), no database needed
# DATA_FILE=./data/mock-data.json
# PERSIST_DATA=true   # true = write changes back to the JSON file, false = keep in memory only

# Must match user-service (>= 32 chars in production). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=user-service

# Shared secret for service-to-service calls (X-Internal-Key), same value in every service.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-to-another-long-random-string-32-chars

# Comma-separated user ids (JWT "sub") allowed to use /admin endpoints
ADMIN_USER_IDS=

# Max requests per minute per IP (health is exempt)
RATE_LIMIT_PER_MINUTE=300

# Number of proxies in front of the service (e.g. API Gateway = 1). Leave empty if none
TRUST_PROXY=

# Allowed origins (comma-separated) or * for development
CORS_ORIGIN=*

# Shipping fee in whole baht; free from FREE_SHIPPING_MIN_CARDS cards
SHIPPING_FLAT_FEE=50
FREE_SHIPPING_MIN_CARDS=5
MAX_CARDS_PER_ORDER=50

# user-service: used to read the saved address for an addressId
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_TIMEOUT_MS=3000

# card-catalog-service: empty = disabled (the card details sent by Gacha are trusted)
CATALOG_SERVICE_URL=
CATALOG_SERVICE_TIMEOUT_MS=3000

# Wallet: false = shipping is not charged (paymentStatus = NOT_REQUIRED)
WALLET_ENABLED=false
WALLET_SERVICE_URL=
WALLET_SERVICE_TIMEOUT_MS=3000

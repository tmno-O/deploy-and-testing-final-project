NODE_ENV=development
PORT=3005

# JWT ต้องเป็นค่าเดียวกับ user-service (ใช้ตรวจ token ของผู้ใช้)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=user-service

# key สำหรับ service อื่น (Gacha) เรียก /internal/* และสำหรับ admin เรียก /admin/*
# ต้องยาวอย่างน้อย 32 ตัวอักษรใน production สร้างด้วย: openssl rand -hex 32
SERVICE_API_KEY=change-me-service-key-at-least-32-characters
ADMIN_API_KEY=change-me-admin-key-at-least-32-characters

# user-service (ใช้ดึงที่อยู่จาก addressId)
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_TIMEOUT_MS=3000

# ค่าส่ง (บาท, จำนวนเต็ม)
SHIPPING_FLAT_FEE=50
FREE_SHIPPING_MIN_CARDS=5
MAX_CARDS_PER_ORDER=50

# Catalog: ว่าง = ปิด (เชื่อข้อมูลการ์ดที่ Gacha ส่งมา)
CATALOG_SERVICE_URL=
CATALOG_SERVICE_TIMEOUT_MS=3000

# Wallet: false = ไม่ตัดค่าส่ง (paymentStatus = NOT_REQUIRED)
WALLET_ENABLED=false
WALLET_SERVICE_URL=
WALLET_SERVICE_TIMEOUT_MS=3000

# ข้อมูลเก็บในไฟล์ JSON (mock data) ไม่ต้องใช้ database
# DATA_FILE=./data/mock-data.json
# PERSIST_DATA=true   # default: true ยกเว้นตอน test

# origin ที่อนุญาต (คั่นด้วย comma) หรือ * สำหรับตอนพัฒนา
CORS_ORIGIN=*

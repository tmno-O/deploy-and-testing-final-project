NODE_ENV=development
PORT=3003

# --- Storage ---------------------------------------------------------------------------------------------
# Default: JSON file (mock data), no database needed.
# Set DATABASE_URL to use PostgreSQL / Supabase instead (JSON file is then ignored). Apply the schema first:
#   npm run db:migrate && npm run db:seed
# Use the Supabase "Transaction pooler" string (port 6543) for the running service; never commit the real value.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=no-verify   # disable | no-verify (default for remote hosts) | require (verifies; also set DATABASE_SSL_CA)
# DATABASE_SSL_CA=         # PEM of Supabase's CA (use \n for newlines) when DATABASE_SSL=require
# DATABASE_POOL_MAX=5      # keep small: Supabase limits concurrent connections
# DATA_FILE=./data/mock-data.json
# PERSIST_DATA=true   # true = write changes back to the JSON file, false = keep in memory only

# Must match user-service (>= 32 chars in production). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=user-service

# Shared secret for service-to-service calls (X-Internal-Key). Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-to-another-long-random-string-32-chars

# Comma-separated user ids (JWT "sub") allowed to use /admin endpoints
ADMIN_USER_IDS=

# Stock reservations expire after this many seconds
RESERVATION_TTL_SECONDS=600
# How often expired reservations are swept in the background
RESERVATION_SWEEP_SECONDS=30

# Max requests per minute per IP on public routes
RATE_LIMIT_PER_MINUTE=300

# Number of proxies in front of the service (e.g. API Gateway = 1). Leave empty if none
TRUST_PROXY=

# Allowed origins (comma-separated) or * for development
CORS_ORIGIN=*

# ค่าที่ทุก service ใน docker-compose.yml (root) ใช้ร่วมกัน
# cp .env.example .env แล้วแก้ทุกค่า secret ด้วย: openssl rand -hex 32

# JWT ที่ user-service ออก และ service อื่นใช้ตรวจ
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=user-service
JWT_EXPIRES_IN=1h

# key ระหว่าง service (header X-Internal-Key) ทุก service ใช้ค่าเดียวกัน
INTERNAL_API_KEY=change-me-to-another-long-random-string-32-chars
# user id (sub ใน JWT) ที่เป็น admin คั่นด้วย comma ว่าง = ไม่มี admin
# ค่าตัวอย่างนี้คือ somying ใน mock data ของ user-service (ใช้ตอน demo)
ADMIN_USER_IDS=a1b2c3d4-0002-4000-8000-000000000002

CORS_ORIGIN=*

# collection-service ดึงข้อมูลการ์ดจาก card-catalog-service (ตั้งเป็นว่างเพื่อปิด)
CATALOG_SERVICE_URL=http://card-catalog-service:3003

# collection-service ตัดค่าส่งจาก wallet-service (false = ส่งฟรีทุกคำสั่ง ไม่เรียก wallet)
WALLET_ENABLED=true
WALLET_SERVICE_URL=http://wallet-service:3002

# port ของหน้าเว็บ (http://localhost:8080)
WEB_PORT=8080

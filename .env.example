# ค่าที่ทุก service ใน docker-compose.yml (root) ใช้ร่วมกัน
# cp .env.example .env แล้วแก้ทุกค่า secret ด้วย: openssl rand -hex 32

# JWT ที่ user-service ออก และ service อื่นใช้ตรวจ
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=user-service
JWT_EXPIRES_IN=1h

# key ระหว่าง service (header X-Service-Key สำหรับ path /internal/*)
SERVICE_API_KEY=change-me-service-key-at-least-32-characters
# key ของ admin (header X-Admin-Key สำหรับ path /admin/*)
ADMIN_API_KEY=change-me-admin-key-at-least-32-characters

CORS_ORIGIN=*

# เปิดจุดเชื่อมของ collection-service เมื่อ service นั้นพร้อม (ใช้คู่กับ docker compose --profile full)
# CATALOG_SERVICE_URL=http://catalog-service:3003
# WALLET_ENABLED=true
# WALLET_SERVICE_URL=http://wallet-service:3002

NODE_ENV=development
PORT=3001

# ข้อมูลเก็บในไฟล์ JSON (mock data) ไม่ต้องใช้ database
# DATA_FILE=./data/mock-data.json
# PERSIST_DATA=true   # true = เขียนการเปลี่ยนแปลงกลับไฟล์ JSON, false = เก็บใน memory อย่างเดียว (รีสตาร์ทแล้วกลับเป็นค่าเริ่มต้น)

# JWT (ต้องยาวอย่างน้อย 32 ตัวอักษรใน production) สร้างด้วย: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=user-service

# จำนวนครั้งที่ login/register ได้ต่อ 15 นาที ต่อ IP
AUTH_RATE_LIMIT_MAX=20

# จำนวน proxy ที่อยู่หน้า service (เช่น API Gateway = 1) ปล่อยว่างถ้าไม่มี
TRUST_PROXY=

# origin ที่อนุญาต (คั่นด้วย comma) หรือ * สำหรับตอนพัฒนา
CORS_ORIGIN=*
